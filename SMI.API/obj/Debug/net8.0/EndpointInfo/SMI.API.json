{
  "openapi": "3.0.1",
  "info": {
    "title": "SMI.API",
    "version": "1.0"
  },
  "paths": {
    "/api/Authentication/FacebookSignIn": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FacebookSignInVM"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/FacebookSignInVM"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/FacebookSignInVM"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/BooleanBaseResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BooleanBaseResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/BooleanBaseResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/Authentication/SocialMediaSignIn": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SocialMediaVM"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/SocialMediaVM"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/SocialMediaVM"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/BooleanBaseResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BooleanBaseResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/BooleanBaseResponse"
                }
              }
            }
          }
        }
      }
    },
